# Local default is SQLite. On FastAPI Cloud the Supabase integration injects DATABASE_URL.
DATABASE_URL=sqlite:///./data/aharya.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise the offline parser and catalogue planner.
LLM_MODE=auto
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
PLANNER_MODEL=claude-opus-5-5
